# ==============================================================================
# CryptoPilot Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME=CryptoPilot
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=cryptopilot-dev-secret-key-change-in-production-min-32-chars

# CORS (Allowed origins separated by comma)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Supabase PostgreSQL / Async connection)
# Supabase URI format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# For local development/testing without live Supabase, sqlite+aiosqlite is used as fallback.
DATABASE_URL=sqlite+aiosqlite:///./cryptopilot.db
SUPABASE_URL=
SUPABASE_KEY=

# CCXT / Exchange Integration
DEFAULT_EXCHANGE=binance
EXCHANGE_SANDBOX=true
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSPHRASE=

# Trading Mode: 'paper' (simulated) or 'backtest'. (Live trading disabled in Phase 1)
TRADING_MODE=paper

# WebSocket and Market Data
WS_REFRESH_INTERVAL_SEC=2.0
DEFAULT_TICKERS=["BTC/USDT","ETH/USDT","SOL/USDT"]
